{
  "document": {
    "color": "{base05}",
    "margin": 0
  },
  "paragraph": {},
  "heading": {
    "block_suffix": "\n",
    "color": "{base05}",
    "bold": true
  },
  "h1": {
    "prefix": "▌ ",
    "color": "{base13}",
    "bold": true
  },
  "h2": {
    "prefix": "▌ ",
    "color": "{base13}",
    "bold": true
  },
  "h3": {
    "prefix": "› ",
    "color": "{base0A}",
    "bold": true
  },
  "h4": {
    "color": "{base0A}"
  },
  "h5": {
    "color": "{base04}"
  },
  "h6": {
    "color": "{base04}"
  },
  "block_quote": {
    "color": "{base04}",
    "italic": true,
    "indent": 1,
