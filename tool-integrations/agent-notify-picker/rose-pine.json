        "color": "{base0B}"
      },
      "keyword_reserved": {
        "color": "{base0D}"
      },
      "keyword_namespace": {
        "color": "{base0D}"
      },
      "keyword_type": {
        "color": "{base0C}"
      },
      "operator": {
        "color": "{base0A}"
      },
      "punctuation": {
        "color": "{base04}"
      },
      "name": {
        "color": "{base05}"
      },
      "name_builtin": {
        "color": "{base0D}"
      },
      "name_tag": {
        "color": "{base0D}"
